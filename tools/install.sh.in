#!/bin/sh
# makeself 自解压安装包的启动脚本（由 tools/build_run.py 生成）
set -eu

BUNDLE_LABEL='@@LABEL@@'
BUNDLE_ARCH='@@ARCH@@'
BUNDLE_VERSION='@@VERSION@@'
BUNDLE_BUILT='@@BUILD_TIME@@'

say() { printf '%s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

say "============================================================"
say " OpenWrt / iStoreOS APK 安装包"
say " 分组    : $BUNDLE_LABEL"
say " 架构    : $BUNDLE_ARCH"
say " 固件    : OpenWrt $BUNDLE_VERSION"
say " 构建时间: $BUNDLE_BUILT"
say "============================================================"
say ""

# makeself 会在解压目录里执行本脚本，这里再显式切一次，保证通配符始终命中
SELF_DIR="$(dirname "$0")"
CDPATH='' cd "$SELF_DIR" || die "无法进入解压目录"

command -v apk >/dev/null 2>&1 || die "未找到 apk 命令。本安装包只适用于使用 apk 包管理器的系统（OpenWrt 25.12+ 及对应的 iStoreOS）"

HAVE_ARCH="$(apk --print-arch 2>/dev/null || true)"
if [ -n "$HAVE_ARCH" ] && [ "$HAVE_ARCH" != "$BUNDLE_ARCH" ]; then
    say "提示: 当前系统架构是 $HAVE_ARCH，而安装包是按 $BUNDLE_ARCH 构建的。"
    say "      纯 LuCI 主题/插件架构为 noarch，可以继续；带二进制的插件需要匹配的架构。"
    say ""
fi

set -- ./*.apk
[ -e "$1" ] || die "安装包内没有找到 .apk 文件"

say "准备安装以下 $# 个软件包："
for f in "$@"; do
    say "  - $f"
done
say ""

say "执行: apk add --allow-untrusted $*"
if ! apk add --allow-untrusted "$@"; then
    say ""
    say "安装失败。常见原因："
    say "  1. 安装包架构与设备不一致"
    say "  2. 缺少外部依赖且软件源不可用，可先执行: apk update"
    say "  3. 设备上已安装互斥的包（例如 Fluent 与 Fluent Lite）"
    exit 1
fi

say ""
say "安装完成。如有需要请重启对应服务或设备。"
